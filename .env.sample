# ==============================================================================
# home-server - the variables the quadlets read through EnvironmentFile=
#
#   THIS FILE IS DOCUMENTATION. The real .env is GENERATED by bin/render-env.sh
#   from secrets/env.sops.env and must never be hand-edited - the next render
#   discards it. Update this file whenever you add a variable, or the next
#   person gets "variable is not set" from a ${VAR:?err}.
# ------------------------------------------------------------------------------
# Update the following variables according to your needs.
#
# Linux users:
#   It is recommended to create a new user "media" to run
#   the containers with, so the applications can access the local filesystem
#   with this user's privileges.
#
#   Use PUID / PGID to map this user's access privileges between the containers
#   and the filesystem.
# ==============================================================================

# ------------------------------------------------------------------------------
# Access Rights
# ------------------------------------------------------------------------------
# There is deliberately NO PUID/PGID here. Every quadlet hardcodes
# Environment=PUID=0, and that is not a privilege escalation: rootless Podman
# maps container UID 0 to the invoking user, core (uid 1000), which is what owns
# /mnt/media and config/. Anything OTHER than 0 maps into the subuid range
# (core:100000:65536) and cannot read the data at all - so making it a variable
# would only invite someone to set it to 1000 and break every container.
# ------------------------------------------------------------------------------

# Default permissions for created files.
UMASK=0002

# ------------------------------------------------------------------------------
# Timezone
# ------------------------------------------------------------------------------
# Synchronize date and time in containers.
# ------------------------------------------------------------------------------

TIMEZONE=Europe/Brussels

# ------------------------------------------------------------------------------
# Volumes
# ------------------------------------------------------------------------------
# The directory must exists and the user defined in PUID / PGID must have read
# and write access to it.
# ------------------------------------------------------------------------------

# Directory where applciations configs will be stored. 
DOCKER_VOLUME_CONFIG=/var/home-server/config

# Root directory for media storage.
DOCKER_VOLUME_MEDIA=/mnt/media

# Scratch space for transcoding. Should live on the fastest disk available and
# is entirely disposable - nothing here is backed up, and it can be deleted
# while the containers are stopped.
#
# Deliberately NOT under DOCKER_VOLUME_MEDIA. That path is the 8TB spinning
# disk, so putting scratch there makes both Tdarr nodes read source media and
# write transcode output to the same spindle, and they end up fighting each
# other for head seeks. Keep this on the SSD.
#
# Kept outside DOCKER_VOLUME_CONFIG too, so backups of that directory do not
# sweep up tens of gigabytes of regenerable scratch.
DOCKER_VOLUME_CACHE=/var/home-server/cache

# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------
# One subnet per trust boundary. The containers are split across several
# networks rather than sharing one bridge, so that a compromised container
# cannot reach an application it has no reason to talk to - see the Network=
# lines in stacks/ for which service joins which.
#
# Any private range works as long as it does not overlap NET_LOCAL_SUBNET below
# or anything else the host routes to. Changing one is NOT a live edit: podman
# will not modify a network in place and will not remove one with containers
# attached, so it takes stopping every unit, `podman network rm`, a
# daemon-reload, then starting again in order.
# ------------------------------------------------------------------------------

# Caddy and the sign-on pair. Pocket ID's TRUST_PROXY and Tinyauth's
# TRUSTEDPROXIES are both set to this, so it must be the network Caddy reaches
# them on or they will attribute every request to the proxy.
NET_SUBNET_INGRESS=172.21.10.0/24

# Sonarr, Radarr, Prowlarr, Jellyseerr, Unpackerr and Caddy.
NET_SUBNET_ARR=172.21.11.0/24

# Prowlarr and FlareSolverr, and deliberately nothing else.
NET_SUBNET_SOLVER=172.21.12.0/24

# Everything that talks to qBittorrent's API, which means everything that
# talks to Gluetun.
NET_SUBNET_DOWNLOAD=172.21.13.0/24

# Jellyfin, Jellyseerr and Caddy.
NET_SUBNET_MEDIA=172.21.14.0/24

# The Tdarr server and its nodes.
NET_SUBNET_TRANSCODE=172.21.15.0/24

# Services that talk only to the internet, such as DuckDNS. They still need a
# bridge for NAT egress; this one has no peers on it.
NET_SUBNET_EGRESS=172.21.16.0/24

# Prometheus, node-exporter, cadvisor and Caddy. The collector segment, and
# deliberately NOT a hub: putting an exporter for each application on both this
# network and that application's own would leave it adjoining net-arr,
# net-download, net-media and net-transcode at once, which is the flat topology
# isolate=true exists to prevent. Prometheus multi-homes instead, as a pure
# client with its listener pinned here.
NET_SUBNET_METRICS=172.21.17.0/24

# Caddy and the dashboard, and nothing else. The dashboard serves static files
# and one read-only JSON; it holds no credential and makes no outbound request,
# so this bridge carries exactly one route.
#
# It is NOT on net-metrics on purpose. That would let it open a connection to
# prometheus:9090 directly, behind the /api/v1/admin/* refusal the Caddyfile
# puts at every public entrance to the store - and Prometheus runs with
# --web.enable-admin-api, which carries delete_series.
NET_SUBNET_DASHBOARD=172.21.18.0/24

# Caddy and the coding-agent control plane: Windmill's server, its database and
# its two workers. The tenth segment, and the first carrying a real database
# container rather than a SQLite file inside an application.
#
# `conduct` is NOT on it and cannot be - it is a systemd --user unit on the
# host, because no container may reach the podman socket and forking podman is
# the whole of its job. It polls the server over a loopback publish instead, so
# the arrow points inward and nothing here has a route back out to the host.
# The phase runners are not on it either; each gets an ephemeral network of its
# own, so model-authored code never shares a bridge with this database.
NET_SUBNET_AGENTS=172.21.19.0/24

# Your home local network, which Gluetun allows outbound so that LAN devices
# can still reach the containers sharing its namespace.
# NOTE: run the following command in a terminal to find out the current subnet:
#   ip -o -f inet addr show | awk '/scope global/ {print $4}'
NET_LOCAL_SUBNET=192.168.0.0/24

# ------------------------------------------------------------------------------
# Theming
# ------------------------------------------------------------------------------
# Applications from the *ARR suite are configured to benefit from a global
# style.
# ------------------------------------------------------------------------------

# Name of a theme for Theme Park.
# See: https://docs.theme-park.dev/theme-options
TP_THEME=nord

# Set to "true" if using a community theme in TP_THEME.
# See: https://docs.theme-park.dev/community-themes/
TP_COMMUNITY_THEME=false

# ------------------------------------------------------------------------------
# Virtual Private Network
# ------------------------------------------------------------------------------
# VPN configuration for enabling security and encryption of network traffic
# through the Gluetun container.
# ------------------------------------------------------------------------------

# VPN type, one of:
#   - wireguard   (recommended: faster, and no auth handshake to go stale)
#   - openvpn
VPN_TYPE=wireguard

# VPN provider to use in the Gluetun container.
# Some providers require a valid (paid) subscription.
# Some providers have a quota on how many devices can use the subscription,
# this will count as one.
VPN_PROVIDER=protonvpn

# ---- WireGuard (used when VPN_TYPE=wireguard) --------------------------------
#
# For ProtonVPN this private key is the ONLY credential required. Gluetun ships
# the public key, endpoint and tunnel address of every Proton server, so the
# other WireGuard variables below stay empty unless you are pinning a specific
# server or using a provider gluetun does not already know.
#
# To obtain it: ProtonVPN dashboard -> Downloads -> WireGuard configuration.
# Tick "NAT-PMP (Port Forwarding)" before generating, otherwise port forwarding
# will not work and torrents will stay unconnectable. Copy the PrivateKey line
# out of the generated .conf file.
VPN_WG_PRIVATE_KEY=

# Optional WireGuard overrides. Leave blank for ProtonVPN.
VPN_WG_ENDPOINT_ADDR=
VPN_WG_ENDPOINT_PORT=
VPN_WG_PUBLIC_KEY=
VPN_WG_PRESHARED_KEY=
VPN_WG_ADDRESSES=

# ---- OpenVPN (used when VPN_TYPE=openvpn) ------------------------------------
#
# Note for ProtonVPN: these are the OpenVPN-specific credentials shown in the
# account dashboard, NOT your Proton login. Gluetun appends nothing for you -
# port forwarding requires the "+pmp" suffix on the username.
VPN_USERNAME=
VPN_PASSWORD=

# Path to the custom config for OpenVPN. Edit only if using a custom
# configuration to connect to OpenVPN.
# The path should lead to an existing file in the Gluetun configuration
# directory, i.e. $DOCKER_VOLUME_CONFIG/gluetun/custom-openvpn.conf.
VPN_OPENVPN_CONFIG=

# ---- Server selection (optional, applies to both VPN types) ------------------
#
# Choose somewhere close for better performance. Leave all blank for any server.
# Note that PORT_FORWARD_ONLY=on already narrows selection to servers that
# support port forwarding, so over-constraining these can leave no candidates.
VPN_SERVER_COUNTRIES=Switzerland,Netherlands
VPN_SERVER_REGION=
VPN_SERVER_CITIES=
VPN_SERVER_HOSTS=

# ------------------------------------------------------------------------------
# Dynamic DNS
# ------------------------------------------------------------------------------
# DuckDNS is used to synchronize your local IP to a chosen domain name.
# See: https://www.duckdns.org/
# ------------------------------------------------------------------------------

# Subdomains to update with DuckDNS
DDNS_SUBDOMAINS=

# DuckDNS Token
DDNS_TOKEN=

# ------------------------------------------------------------------------------
# Ingress and Identity
# ------------------------------------------------------------------------------
# Caddy terminates TLS and reverse-proxies every service. Routing lives in
# apps/caddy/Caddyfile, which reads DOMAIN from here, so adding a service is a
# CNAME plus a block in that file - there is no certificate list to maintain.
#
# Access control is Pocket ID (passkey-only OpenID Connect provider) with
# Tinyauth bridging Caddy's forward_auth to it for the applications that have
# no single sign-on of their own.
# ------------------------------------------------------------------------------

# The domain every service is a subdomain of, e.g. example.com gives
# sonarr.example.com. Replaces CERT_DOMAIN, which goes away with SWAG.
DOMAIN=

# Gandi Personal Access Token, used to answer the DNS-01 challenge.
#
# This is NOT the same credential as the legacy dns_gandi_api_key that certbot
# used: that type is deprecated and caddy-dns/gandi will not authenticate with
# it. Generate a PAT with DNS write access in the Gandi account settings.
GANDI_BEARER_TOKEN=

# The URL Pocket ID is reached at, INCLUDING a port if it is not 443.
#
# WebAuthn validates the full origin string the browser sends against this, so
# a mismatch - typically a missing port while testing on a spare one - fails
# passkey registration at the last step with an unhelpful "couldn't process the
# response from your passkey". The relying party ID is the hostname alone, so a
# passkey enrolled on a spare port keeps working once you move to 443.
POCKETID_APP_URL=https://id.example.com

# Encrypts Pocket ID's passkey and OIDC client material at rest. Generate with:
#   openssl rand -base64 32
# Lose this and every registered passkey becomes unreadable, so back it up.
POCKETID_ENCRYPTION_KEY=

# OIDC client credentials for Tinyauth. These do not exist until Pocket ID has
# an admin account: create one at https://id.${DOMAIN}/setup, then register an
# OIDC client with the callback URL
#   https://auth.${DOMAIN}/api/oauth/callback/pocketid
# and paste the generated pair here.
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=

# Comma-separated list of accounts allowed to sign in, by email address.
# Without it, any account Pocket ID knows about can reach every protected
# service.
AUTH_WHITELIST=

# ------------------------------------------------------------------------------
# Port Bindings
# ------------------------------------------------------------------------------
# Which host interface a published port binds to. Docker's default is 0.0.0.0,
# every interface, which is not contained by firewalld: Docker's DNAT rules are
# evaluated first, so a published port stays reachable whatever the active zone
# allows.
#
# Almost nothing is published any more. Caddy reaches each service by name over
# the bridge, so admin ports were a second way in that single sign-on did not
# cover, and they are gone. What remains is what genuinely has to be spoken to
# directly.
# ------------------------------------------------------------------------------

# Services LAN devices connect to without going through Caddy: Jellyfin clients
# (TVs, phones) and the Gluetun proxies. Set this to the host's LAN address
# (e.g. 192.168.0.10) to keep them off the public interface; 0.0.0.0 binds every
# interface and relies on the router not forwarding them.
BIND_LAN=0.0.0.0

# ------------------------------------------------------------------------------
# Applications Ports
# ------------------------------------------------------------------------------
# Network ports used by the different applications running inside
# the containers. Most of the are used to access the user interface from your
# browser.
# ------------------------------------------------------------------------------

# Caddy, the public ingress. Redirect incoming traffic on your Internet gateway
# to the host on these ports:
#
#   Address From | Port From | Address To    | Port To
#   --------------------------------------------------
#   0.0.0.0      |        80 | 192.168.0.100 |      80
#   0.0.0.0      |       443 | 192.168.0.100 |     443
PORT_CADDY_HTTP=80
PORT_CADDY_HTTPS=443







# QBittorrent
# No peer port. With VPN_PORT_FORWARDING=on, incoming peers arrive through the
# tunnel on the port ProtonVPN forwards, landing straight in gluetun's
# namespace - and that port changes on every reconnect, so there is nothing
# stable to publish on the host. VPN_PORT_FORWARDING_UP_COMMAND pushes it into
# qBittorrent over its API each time the tunnel comes up.
PORT_QBITTORRENT_WEB=8200

# JOAL
PORT_JOAL_WEB=8221

# Jellyfin
PORT_JELLYFIN_WEB=8096


# Tdarr
PORT_TDARR_SERVER=8266
PORT_TDARR_WEB=8265


# ------------------------------------------------------------------------------
# Applications Config
# ------------------------------------------------------------------------------
# Some applications (like Unpackerr) require information from other applications
# to work seemlessly. These can be provided in a config file or throught
# the following environment variables when applicable and if you already know
# their value.
# ------------------------------------------------------------------------------

# Radarr API Key (for Unpackerr, bin/promote-transcoded.py and
# bin/collect-metrics.py)
RADARR_API_KEY=

# Sonarr API Key (for Unpackerr, bin/promote-transcoded.py and
# bin/collect-metrics.py)
SONARR_API_KEY=

# Prowlarr API Key (for bin/collect-metrics.py). This is the one that buys the
# most: it surfaces per-indexer health, and the ISP resolver returning a
# blocking page for four indexers is a failure where every container stays
# green and the only symptom is that nothing is found. Read it out of the
# application rather than the UI:
#   podman exec prowlarr sed -n 's|.*<ApiKey>\(.*\)</ApiKey>.*|\1|p' /config/config.xml
PROWLARR_API_KEY=

# Bazarr API Key (for bin/collect-metrics.py). Note the header is X-API-KEY,
# not the *arr apps' X-Api-Key - Bazarr is not a Servarr application and does
# not share their API. Read it with:
#   podman exec bazarr grep -m1 apikey: /config/config/config.yaml
BAZARR_API_KEY=

# Jellyfin API Key (for bin/promote-transcoded.py, to trigger a library scan
# once a file has been promoted into library/transcoded/). Create it in
# Jellyfin under Dashboard > API Keys; the promotion still works without it,
# it just waits for Jellyfin's own scheduled scan instead.
JELLYFIN_API_KEY=

# JOAL Obfuscation Path
JOAL_OBFUSCATION_PATH=

# JOAL Secret
JOAL_SECRET_TOKEN=

# ------------------------------------------------------------------------------
# Alerting
# ------------------------------------------------------------------------------
# The chain is Prometheus rules -> Alertmanager -> ntfy-alertmanager -> ntfy ->
# your phone. Two of those three containers read a CONFIG FILE and substitute
# nothing in it, so these do not reach them through Environment= like every
# other secret here - bin/render-template.py writes them into the rendered
# config from an ExecStartPre=. See its header for why a bcrypt hash cannot go
# through systemd.
#
# BOTH A PASSWORD AND ITS HASH ARE STORED, which looks redundant and is not.
# ntfy declares its users by bcrypt hash; the bridge and your phone
# authenticate with the plaintext. Generate a matching pair with:
#   printf 'PASSWORD\nPASSWORD\n' \
#     | podman run --rm -i docker.io/binwiederhier/ntfy:v2 user hash
# ------------------------------------------------------------------------------

# The account your phone subscribes with. Read-write on the one topic; not an
# admin - see apps/ntfy/server.yml for why neither account is.
NTFY_USER=
NTFY_USER_PASSWORD=
NTFY_USER_HASH=

# The account the bridge publishes with. WRITE-ONLY on the same topic, so a
# credential sitting in a container config cannot read the alert history.
NTFY_ALERT_PASSWORD=
NTFY_ALERT_HASH=

# The account conduct publishes with when an agent run is waiting for you.
# WRITE-ONLY, on the SAME TOPIC, so your phone keeps one subscription.
#
# ITS OWN ACCOUNT RATHER THAN THE BRIDGE'S, for the reason the bridge's own
# comment gives one line up: a credential should carry the least it can, and
# reusing NTFY_ALERT_PASSWORD would put the alert chain's credential into a
# host-side script that has nothing to do with alerting. It is also the only way
# to revoke one publisher without silencing the other.
#
# WHAT IT NOTIFIES ABOUT IS NEVER A RESUME URL - see docs/agents.md. What travels
# is a link to Windmill's approval page, which is behind the passkey; ntfy is
# deliberately outside sign-on, so a signed resume URL here would make this
# password sufficient to approve an agent's merge.
NTFY_CONDUCT_PASSWORD=
NTFY_CONDUCT_HASH=

# HTTP basic auth between Alertmanager and the bridge. Both are on net-metrics
# and neither is published, so this is defence in depth rather than the barrier
# - but the bridge's webhook endpoint would otherwise accept an alert from
# anything that could reach it, and "nothing else is on this segment" is a
# property that changes when someone adds a container.
ALERT_WEBHOOK_PASSWORD=

# ------------------------------------------------------------------------------
# Backups
# ------------------------------------------------------------------------------
# Read by bin/backup-server.sh, which runs on the server nightly from
# home-server-backup.timer. See the header of that script for why there are two
# destinations and why the off-site key is scoped the way it is.
#
# THE OFF-SITE KEY MUST NOT BE ABLE TO DELETE. It is a Scaleway application key
# with a bucket policy allowing PutObject, GetObject and ListBucket, and denying
# DeleteObject everywhere except the locks/ prefix. That is what keeps "a
# compromised server cannot destroy the backups" true now that the server drives
# the schedule. The workstation holds a separate admin key, which is the only
# thing that may prune, and which must NEVER be added here.
# ------------------------------------------------------------------------------

# Local restic repository, on the server. Deliberately on /var rather than
# /mnt/media: the media disk is kept for media. It is therefore on the SAME disk
# as config/ and does not survive that disk failing - which is what the off-site
# copy below is for.
BACKUP_LOCAL_REPOSITORY=/var/backups/home-server

# Password for the local repository. Generate with `openssl rand -base64 32`.
# Losing it means losing that repository; it belongs in the password manager
# alongside the age keys and the off-site password.
BACKUP_LOCAL_PASSWORD=

# Off-site restic repository. Same repository the workstation copies to, so the
# endpoint must match the region the bucket was created in or the first call
# fails with a bare 403 that says nothing about regions.
BACKUP_OFFSITE_REPOSITORY=

# Password for the off-site repository. `restic copy` re-encrypts blob by blob,
# so this is deliberately NOT the same as BACKUP_LOCAL_PASSWORD: one compromised
# credential loses one copy.
BACKUP_OFFSITE_PASSWORD=

# The append-only Scaleway application key. Not the admin one.
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Coding agents
# ------------------------------------------------------------------------------
# Windmill is the control plane for the autonomous coding-agent pipeline: it
# holds the human approval gates, the task poll schedule and the operator
# console. It never spawns an agent and never touches a worktree - those are
# host operations, and no container here can perform them, because the podman
# socket is SELinux-denied from container_t. `conduct`, the orchestrator that
# does them, is a systemd --user unit; see docs/agents.md.
# ------------------------------------------------------------------------------

# Where windmill-server publishes, ON LOOPBACK ONLY.
#
# The bind address is the whole exposure and it is not a default. A plain
# PublishPort= would put the agent control plane on the LAN, past Caddy and past
# sign-on - the shape the access log caught internet scanners walking on the
# *arr APIs. Bound to 127.0.0.1 it is reachable by `conduct` and by nothing
# else, firewalld never enters the picture, and this design therefore needs no
# change to host/butane/ucore.bu.
#
# Browsers reach it through Caddy at agents.${DOMAIN}, behind the passkey
# prompt, like every other admin surface here.
PORT_WINDMILL_HTTP=8300

# Postgres for Windmill: the only database CONTAINER in this stack. Every other
# stateful service embeds SQLite, which is why bin/snapshot-databases.sh finds
# them by magic bytes and why this one needs a pg_dumpall leg of its own.
WINDMILL_DB_USER=windmill
WINDMILL_DB_NAME=windmill

# NO WHITESPACE, AND NO URL-RESERVED CHARACTER. This value is interpolated into
# a postgres:// URI in windmill-server.container, so an @ / : or ? breaks the
# parse with an error naming the host rather than the credential - and quadlet
# splits Environment= on whitespace and truncates the rest in silence.
# Generate with:  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40
WINDMILL_DB_PASSWORD=

# HOW conduct AUTHENTICATES TO THE CONTROL PLANE. A Windmill API token, minted in
# the UI at agents.${DOMAIN} under Account settings -> Tokens, and the only thing
# standing between conduct and `jobs/queue/list` - which is a 401 without it,
# measured.
#
# UNSET IS A ROLLOUT, NOT A FAULT, and conduct treats it that way: with no token
# it holds the poll, says so once a cycle, and leaves the heartbeat green. A token
# the control plane REFUSES fails the cycle instead, because that is a fleet which
# has stopped taking work while every container is healthy and every unit is
# active. Do not "fix" a 401 by clearing this value.
#
# IT IS A WORKSPACE-OWNER TOKEN, and that is an accepted risk rather than a
# setting nobody looked at: Windmill CE's token scopes do not express "may list
# and resume jobs and nothing else". What bounds it is that windmill-server is on
# loopback, so the token is only usable from this host - and revoking it in the
# UI is a browser-reachable kill switch for the fleet's ability to take work.
WINDMILL_CONDUCT_TOKEN=

# The workspace both conduct and Caddy address. It has a default in conduct's
# config.py; naming it here is what gives the two ONE value rather than a Python
# constant and a string in a Caddyfile that agree until they do not.
WINDMILL_WORKSPACE=dev-agents

# The token Caddy injects on `home.{$DOMAIN}/api/control/*`, so the dashboard can
# ask the fleet to do something without holding a credential itself.
#
# A THIRD TOKEN, DELIBERATELY, on GITHUB_PR_READ_TOKEN's precedent: widening one
# credential must never become the way a second consumer is added. This one is
# reachable from a browser and conduct's is not, so they must be revocable
# separately - pulling this one leaves the fleet running and takes the buttons
# away, which is the direction that should be cheap.
#
# IT IS SCOPED, AND THAT WAS MEASURED RATHER THAN ASSUMED. Mint it with
# `scopes: ["run:flow/f/agents/control"]`. The comment on WINDMILL_CONDUCT_TOKEN
# above says Windmill CE cannot express "may list and resume jobs and nothing
# else", and that is still true of what CONDUCT needs - but `run:flow/<path>` is
# expressible and is enforced: measured against 1.792.2, a token carrying it
# answers 403 on jobs/queue/list, flows/get, variables/list and users/whoami,
# where conduct's workspace token answers 200 on all four. Reading a schema is
# not measuring an endpoint, so both directions were checked.
#
# AND THE ROUTE BOUNDS IT AGAIN. The Caddy block REWRITES to a single literal
# path and discards whatever the client asked for, so the only thing that reaches
# Windmill is a run of f/agents/control - one endpoint rather than an allowlist
# with holes in it. The body is then validated twice: by the flow's schema, and
# by conduct on the host, which is the guard that counts. Three layers, and the
# scope is the one that would still hold if the other two were misconfigured.
#
# UNSET IS A ROLLOUT, NOT A FAULT. With this empty the route answers 401, the
# board renders every control disabled and says why, and the fleet behaves
# exactly as it did before - `conduct ship` and the run form are untouched.
# fleet.json carries whether it is set so the page can tell absent from broken.
#
# Mint it with the API rather than the UI, because the UI's token form does not
# offer scopes. LOAD .env FIRST: an interactive ssh has none of these variables,
# so without the first line the URL becomes `http://127.0.0.1:/api/...` and the
# header a bare `Bearer` - and `curl -s` prints NOTHING AT ALL for both, which
# reads as an endpoint that does not exist.
#   set -a; . /var/home-server/.env; set +a
#   curl -sX POST "http://127.0.0.1:${PORT_WINDMILL_HTTP}/api/users/tokens/create" \
#     -H "Authorization: Bearer $WINDMILL_CONDUCT_TOKEN" \
#     -H 'Content-Type: application/json' \
#     -d '{"label":"dashboard control","scopes":["run:flow/f/agents/control"]}'
# It prints the token once, and nothing can print it again. Revoke it with
# DELETE /api/users/tokens/delete/<token_prefix>, taking the prefix from
# /api/users/tokens/list - it is 10 characters, not the 8 this line used to say,
# and the list is also how you check a scope actually took.
WINDMILL_DASHBOARD_TOKEN=

# The token behind home.{DOMAIN}/api/approve/*, scoped
# `scopes: ["run:flow/f/agents/approve"]`. SEPARATE FROM THE ONE ABOVE ON
# PURPOSE: each can start exactly one flow, so neither route can be used to
# reach the other's, and a leak of either is bounded by what that one flow does.
#
# WHAT THIS ONE CAN DO IS OPEN A PULL REQUEST, which is more than the control
# token can do, and it is the reason the flow behind it reads the target job
# before answering: f/agents/approve refuses unless the step waiting is
# `publish_pr`. conduct answers modules named `conduct_*` and nothing else; this
# answers `publish_pr` and nothing else. Neither can do the other's job, and
# both read the name from conduct/flows/common.py.
#
# IT REPLACED A LOCK RATHER THAN ADDING ONE. `user_auth_required: true` used to
# sit on that step and made the owner resume endpoint fail as an enterprise
# feature; removing it is what lets any server-side token answer, so the prefix
# refusal in conduct/poll.py is now the only thing keeping conduct off its own
# gate. That refusal is asserted in tests that are run inverted first.
#
# UNSET IS A ROLLOUT, NOT A FAULT, exactly as above: the route answers 401, the
# board disables Approve and Decline and says why, and Windmill's own run page
# keeps working - which is how every approval was answered before this existed.
#
#   set -a; . /var/home-server/.env; set +a
#   curl -sX POST "http://127.0.0.1:${PORT_WINDMILL_HTTP}/api/users/tokens/create" \
#     -H "Authorization: Bearer $WINDMILL_CONDUCT_TOKEN" \
#     -H 'Content-Type: application/json' \
#     -d '{"label":"dashboard approve","scopes":["run:flow/f/agents/approve"]}'
WINDMILL_APPROVE_TOKEN=

# How long Windmill keeps each job's result and logs, in seconds. WITHOUT THIS
# THE DATABASE GROWS FOREVER: it stores every run in Postgres, on the disk that
# also carries config/, /var/backups and the metrics store. 30 days.
WINDMILL_JOB_RETENTION_SECS=2592000

# ------------------------------------------------------------------------------
# The model credential, which is ONE token and was two until 2026-08-24
# ------------------------------------------------------------------------------
# From `claude setup-token` on a machine that is already signed in - a long-lived
# token that draws on the SUBSCRIPTION, deliberately not an API key, which would
# be a second and unmetered billing path that nothing here watches.
#
# WHY THERE WAS A SECOND ONE, AND WHY THERE IS NOT NOW. The runner's copy is
# handed to a container as an environment secret, so it sits in /proc/1/environ
# where anything the phase runs can read it - a lockfile postinstall included.
# That risk is accepted and recorded in docs/agents.md, and the second token
# existed so that revoking this one after an exfiltration did not also blind the
# pacing that decides whether the fleet may dispatch at all. conduct read the
# quota with it, from GET /api/oauth/usage.
#
# THAT ENDPOINT ANSWERS 403 TO A setup-token - permission_error, scope
# user:profile, measured from this host with the real credential before anything
# rested on it. So the pacing signal moved onto the phase's OWN model call, which
# reports the API's unified rate-limit status in its stream; see
# conduct/quota.py. Revoking the runner's token now stops the phases that produce
# the reading, so a second token no longer buys the independence it was for, and
# what it did still cost was real: home-server-conduct.service reads this file,
# so conduct's own process held a DIFFERENT token under CLAUDE_CODE_OAUTH_TOKEN -
# the exact name the CLI reads inside the runner, and one missing `=` on a podman
# `-e` would have handed a phase the wrong valid token in silence.
#
# ROTATING IT NEEDS A SIGNED-IN WORKSTATION, which is the cost of collapsing to
# one and is stated rather than discovered: `claude setup-token` is interactive.
#
# IT IS NOT RENDERED INTO A CONTAINER BY A TEMPLATE. It reaches a phase as
# `--secret`, from a podman secret that bin/sync-podman-secrets.sh creates over
# stdin - never as `Environment=` on a unit, which
# `systemctl --user show -p Environment` prints in full.
CLAUDE_RUNNER_OAUTH_TOKEN=

# ------------------------------------------------------------------------------
# The CI runner's credential, which is the one value here that must never enter
# a container
# ------------------------------------------------------------------------------
# A FINE-GRAINED PERSONAL ACCESS TOKEN ON THE avanserv ORGANISATION, with exactly
# one permission: Organization permissions -> Self-hosted runners -> Read and
# write. Nothing else, and in particular not `repo`. That single permission is
# what POST /orgs/<org>/actions/runners/generate-jitconfig requires.
#
# A CLASSIC PAT WOULD NEED `admin:org`, which is every setting the organisation
# has - members, teams, webhooks, billing - on a token that lives in a rendered
# .env on a machine in a cupboard. The fine-grained one can register runners and
# do nothing else, which is the whole difference.
#
# IT IS READ ON THE HOST AND NOWHERE ELSE. bin/github-runner.sh mints a
# single-use just-in-time runner configuration with it and hands the container
# only that. The token itself never reaches a mount, an argument vector or an
# environment inside one - not even as a curl -H, which would put it in
# /proc/<pid>/cmdline where anything running as `core` could read it; it goes to
# curl over stdin. bin/github-runner-smoke.sh asserts the absence rather than
# assuming it, because the assertion is one line and the assumption is how a
# credential ends up in /proc/1/environ.
#
# IT IS DELIBERATELY NOT A PODMAN SECRET, and that is the inverse of the argument
# bin/sync-podman-secrets.sh makes for the model credential. A podman secret
# exists to get a value INTO a container without it appearing on a unit's
# Environment= or at a second path on disk. This value must never get into a
# container at all, so making it a secret would build the route it must not have.
# EnvironmentFile= is enough: `systemctl --user show -p Environment` prints
# Environment= assignments, not the contents of a file.
#
# A FINE-GRAINED PAT EXPIRES, AND NOTHING HERE CAN PROVE IT STILL AUTHENTICATES -
# only the next mint can. A lane treats 401 and 403 as unrecoverable and comes to
# rest in `failed` rather than retrying, so the expiry surfaces within one poll
# as ci.lanes_alive rather than as jobs that quietly stop being picked up. Note
# also that an organisation may require fine-grained tokens to be APPROVED before
# they work at all, and an unapproved one answers 403 - which reads as a
# permissions bug rather than as a pending request.
GITHUB_RUNNER_PAT=

# ------------------------------------------------------------------------------
# A SECOND, SEPARATE, READ-ONLY TOKEN, and the separation is the point.
#
# The Agents page hides a fleet round once its pull request is merged, and
# avanserv/upskald is private - so that state needs a credential. Neither of the
# two that already exist may be reused: the Windmill variable
# f/agents/github_pr_token is `pull_requests: write` and is what opens a pull
# request in the first place, and GITHUB_RUNNER_PAT above is org-scoped for
# runner registration. Widening either would give a monitor the ability to act.
#
# Fine-grained, on avanserv/upskald only, with exactly one permission:
# Repository permissions -> Pull requests -> Read-only.
#
# THIS IS THE ONLY HOST-SIDE NETWORK CALL bin/collect-metrics.py MAKES. Every
# other outbound request in that file goes through `podman exec <container>
# curl`, and this one cannot, because the token must not enter a container -
# the same rule docs/ci.md states for the credential that never enters a lane.
#
# ABSENT IS A SUPPORTED STATE AND MUST STAY ONE. The board fails OPEN: with no
# token, or with GitHub unreachable, every round stays visible with pr_state
# "unknown" and fleet.json's `sources.github` says why. A round disappearing
# because a token expired would be the same class of error as an empty list
# reading as an idle fleet, which is what that whole document exists to prevent.
GITHUB_PR_READ_TOKEN=

# The repository the fleet works in, as `owner/name`, so the run board can link
# a branch it has pushed but not yet opened a pull request for.
#
# A SECOND COPY OF A FACT conduct ALREADY HAS. The authority is `slug` in
# /var/agents/conduct/config.py, and bin/collect-metrics.py cannot read it - a
# Python module in another repository is not configuration this process can
# import. So it is named again here, which is drift waiting to happen.
#
# THE DRIFT IS CLOSED BY MEASUREMENT RATHER THAN BY THIS COMMENT. Whenever a
# round also carries a pull request, that URL contains the real slug, and
# _fleet_branch_url compares the two. A disagreement WITHHOLDS every branch link
# rather than following it, so the symptom is a branch name that will not click
# - and the collector says which two it saw on stderr, where the journal keeps
# it. Unset is the same, quietly: the name still renders, nothing links.
#
# NOT A SECRET, and it is in secrets/env.sops.env only because that is where
# .env is rendered from. sops leaves the variable names legible on purpose.
AGENTS_REPO_SLUG=avanserv/upskald

# The organisation the lanes register against. ONE org-level registration covers
# every repository in it, which is why this is a name and not a list.
#
# brinkflew/* IS OUT OF SCOPE AND CANNOT BE BROUGHT IN. GitHub has no
# account-level self-hosted runners - only repository, organisation and
# enterprise - so a personal repository would need its own registration per
# repository. That is a different design and it is not this one.
GITHUB_RUNNER_ORG=avanserv

# THE RUNNER GROUP, AND THERE IS NO DEFAULT ON PURPOSE. bin/github-runner.sh
# refuses to start without it rather than falling back to 1.
#
# Group 1 is the organisation's Default group, which EVERY repository can see -
# including the three public ones (vsx-antigravity-quota, vsx-avanserv-theme,
# dialog). A self-hosted runner reachable from a public repository executes fork
# pull-request code on this host, as `core`, which owns /var/home-server and
# every credential in it. Defaulting to 1 would make the safe configuration the
# one somebody has to remember.
#
# So: make a runner group in the organisation's Actions settings, scope it to
# SELECTED repositories, leave "Allow public repositories" off, and put its id
# here. Adding a repository later is then a click in that group rather than a
# deploy. The id is in the URL of the group's settings page, and
#   gh api /orgs/avanserv/actions/runner-groups
# lists them with an admin:org or fine-grained runner token.
GITHUB_RUNNER_GROUP_ID=

# The label set a just-in-time configuration is minted with, and therefore what
# `runs-on:` can target.
#
# SPELLED OUT IN FULL RATHER THAN LEFT TO THE RUNNER'S OWN DEFAULTS, because a
# JIT configuration's `labels` array IS the whole set - "the runner adds the
# standard three" is a thing to verify, not to assume. `home-server` is the one a
# workflow opts in with.
#
# NEVER ADD `ubuntu-latest` HERE. It looks like the zero-edit way to move every
# job at once and it is a trap: GitHub falls back to a hosted runner only when no
# runner carrying that label is CONNECTED, so the same workflow would silently
# alternate between a hosted Ubuntu image and a two-core container depending on
# whether a lane happened to be registered at that instant - flaky,
# environment-dependent, and near-impossible to attribute from a job log. It
# would also capture release-please, auto-merge and pr-recap, stalling merges
# behind CI. See docs/ci.md.
GITHUB_RUNNER_LABELS=self-hosted,Linux,X64,home-server

# ------------------------------------------------------------------------------
# The tracker
# ------------------------------------------------------------------------------
# WHERE THE WORK COMES FROM AND WHERE ITS STATE GOES. A flow run carries an Odoo
# task id; conduct reads the title and the acceptance criteria out of it, renders
# them into the phase's prompt, and moves the task through Planning ->
# Implementation -> Review as the run progresses. It never moves one past Review
# and never moves one back out of it - what happens after review is a person's.
#
# CONDUCT IS THE ONLY THING THAT HOLDS THESE. The workstation reaches Odoo
# through an MCP server and a phase deliberately does not: that would put a
# second credential in a container that already carries the model token in
# /proc/1/environ, and it would make moving a task something a model decides
# rather than something the pipeline does.
#
# THE API IS ODOO'S JSON-2, not XML-RPC: POST /json/2/<model>/<method> with
# `Authorization: Bearer` and `X-Odoo-Database`. Measured against the live
# instance rather than read out of documentation - `create` wants `vals_list`
# and `write` wants `ids`/`vals` as kwargs, and the obvious spellings 422.
#
# UNSET IS A ROLLOUT, NOT A FAULT. With these empty the fleet runs exactly as it
# did before: `task` carries the work in words, no stage moves, and the approval
# card says the tracker was not consulted.
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# The Odoo project the fleet works in. A number rather than a name because the
# name is still the pre-rebrand one, and resolving by name would tie the fleet
# to a rename nobody has finished.
ODOO_PROJECT_ID=17
