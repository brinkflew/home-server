# ==============================================================================
# Rebuild the CI lane image weekly, ahead of every other source build
# ------------------------------------------------------------------------------
# Saturday 20:00: an hour before home-server-conduct-runner-build.timer, two
# before Caddy's and four before podman-auto-update.timer. Nothing depends on
# that ordering - this unit restarts no container, and auto-update never touches
# an image with no container to update - but this is the longest of the four
# builds and putting it first is what keeps the evening's journal readable.
#
# WEEKLY, AND THE STALENESS IS PRICED DIFFERENTLY HERE THAN FOR ITS SIBLINGS.
# For conduct-runner a week behind is a week behind on a tool; for this image it
# is a week closer to a deadline somebody else set. GitHub enforces a MINIMUM
# runner version - a runner too far behind stops being given jobs, and the
# symptom is a job that queues for ever while the runner shows online and idle.
#
# THIS TIMER IS THE ONLY DEFENCE AGAINST THAT, and it is a real one. A
# just-in-time runner polls with `disableUpdate=true` and never updates itself,
# so the seed this image carries is the version every lane runs - measured on
# 2026-11-05, when 2.336.0 was refused for four days. bin/runner-release.sh
# builds upstream's latest each week and bin/github-runner.sh re-seeds a lane
# whose tree differs from the promoted image, so a release reaches every lane
# within a week plus one idle period. ci.runner_version warns when it has not.
#
# So the cadence is chosen the way conduct-runner's is: the build is over a
# gigabyte with two apt runs and a browser dependency set, and a nightly build
# whose smoke fails is a nightly `failed` unit. The :next -> smoke -> :latest
# promotion is what makes a week safe, not the week itself.
#
# Persistent=true so a machine that was off on Saturday rebuilds when it comes
# back rather than skipping the week.
#
# IT DOES NOT COVER THE FIRST INSTALL. `systemctl --user enable --now` writes the
# stamp file immediately, so there is no missed elapse to catch up on and the
# unit does NOT fire - measured, and recorded on
# home-server-conduct-runner-build.timer where it was found. This image has the
# same exposure and worse consequences: no .container references it, so on a host
# that has never run this unit the image does not exist, and every lane exits
# non-zero at its preflight until the first Saturday. The one-time
# `systemctl --user start` is part of the setup in host/systemd/README.md.
# ==============================================================================

[Unit]
Description=Rebuild and verify the GitHub Actions CI runner image weekly

[Timer]
OnCalendar=Sat *-*-* 20:00
Persistent=true
RandomizedDelaySec=15min
AccuracySec=5min

[Install]
WantedBy=timers.target
