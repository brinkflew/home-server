# ==============================================================================
# The aggregate ceiling for the agent fleet
# ------------------------------------------------------------------------------
# Per-unit limits are not a mechanism for this, and this repository proves it:
# twenty-four quadlets declare 34.5 GiB of MemoryMax against 15.5 GiB of RAM and
# it works, because the unit count is fixed and the peaks do not coincide. The
# fleet breaks both properties. Its phase runners are `podman run --rm` under
# transient scopes, so the count is a variable rather than a constant, and a
# phase peaks exactly when the next one starts. So the ceiling goes one level up
# and the kernel enforces the sum: every Windmill container, conduct itself and
# every runner scope joins this slice.
#
# THE `app-` PREFIX IS LOAD-BEARING, not decoration. systemd derives the
# hierarchy from the dashes in the name, so this nests under app.slice, where
# every quadlet already lives. A top-level `agents.slice` would put these
# cgroups outside the path bin/collect-metrics.py joins on and cost every member
# 32 of its 43 series - with nothing but home_server_container_identity_
# unresolved to say so, and that counter's own help text calls it a broken join.
#
# Sized against a measurement rather than against the declared sum. Over the
# whole history of the metrics store the peak sum of every container's working
# set was 5,914 MB and the worst MemAvailable was 9,715 MB, so a 4.6 GB hard
# reservation still leaves about 5 GB at the worst moment anything here has
# recorded. That window is 4.31 days rather than for ever - revisit it after a
# full Tdarr queue has run through.
#
# MEASURED AGAINST A REAL PHASE ON 2026-08-20, which is the first thing able to:
# a full `make install && make check` of upskald inside the runner, with the
# Windmill units up and the three phase datastores in here too, peaked the slice
# at 3,566M against the 3,584M MemoryHigh below - 99.5% of it - while memory.max
# events stayed 0 and oom_kill stayed 0.
#
# THAT IS THE DESIGN WORKING RATHER THAN A CEILING TO RAISE, and the distinction
# is the one docs/known-state.md already records for Jellyfin: read `anon` against
# `inactive_file` and memory.pressure, never the `high` counter. The runner's own
# anon was 302 MB against 336 MB of page cache, and its pressure read
# avg300=0.02 - about half a second of stall across a seven-minute run. What is
# pinned at MemoryHigh is `uv sync` and `bun install` writing hundreds of
# megabytes of cache, and reclaiming it is what MemoryHigh is for. The 1,042M
# between that peak and MemoryMax is the margin that matters.
#
# CPUQuota AS WELL AS CPUWeight. A weight only bites under contention, and
# `npm ci` beside a threaded test runner will take all twelve cores the moment
# they are free. The symptom of relying on the weight alone is a stuttering
# Jellyfin UI while every directive behaves exactly as documented. 400% is four
# cores of twelve.
#
# ITS FAILURE IS SILENCE, which is the whole reason agents.slice_limits reads
# these values back out of the cgroup rather than out of this file. A `Slice=`
# naming a slice with no unit file does NOT fail: systemd instantiates it with
# defaults, and every member then starts, stays healthy, stays fully observed
# and is contained by nothing at all. That is the io-delegation failure one
# directive over, which was inert here for months. Verify, never assume:
#   cat /sys/fs/cgroup/user.slice/user-1000.slice/user@1000.service/app.slice/\
#       app-agents.slice/memory.max
#
# Symlinked into ~/.config/systemd/user/ - see host/systemd/README.md, whose
# setup loop globs by extension and had to be widened for this one.
# ==============================================================================

[Slice]
MemoryHigh=3584M
MemoryMax=4608M
CPUWeight=30
CPUQuota=400%
# THE OTHER HALF OF THAT QUOTA, missing for as long as the quota existed.
#
# CPUQuota PROTECTS THE HOST AND TELLS THE GUEST NOTHING. A container is not
# CPU-namespaced - docs/known-state.md already records it for Chromium and node -
# so `nproc` and node's os.availableParallelism() inside a phase both report the
# host's 12 while this cgroup will only ever deliver 4. Every tool that sizes a
# worker pool from those, which is vitest, playwright, esbuild, tsc and any
# `make -j$(nproc)`, then starts three times the workers the quota can run and
# the kernel enforces the difference by throttling all of them.
#
# MEASURED ON 2026-08-24, the same web unit suite in the same tree, five runs:
#
#   nproc=12   4457 tests, 1 FAILED    363.54s, 340.17s   environment 1623.12s
#   nproc=4    4457 tests, 0 failed     69.45s,  70s, 71s environment   82.62s
#
# FIVE TIMES FASTER AND GREEN. Three times the workers should raise those
# per-worker sums about three times; they were nineteen times higher, so each
# worker was also running six times slower. The pinned runs throttle twice, for
# 57ms total.
#
# AND THE COST WAS NOT THE WALL CLOCK. The failure was one component spec timing
# out at 5000ms that takes 1.8s alone, so conduct/verify.py refused a correct
# change and reported it as the phase's fault - twice, reproducibly. A gate that
# is slow is an annoyance; a gate that is wrong is worse than no gate.
#
# HERE RATHER THAN ON THE PHASE SCOPE, so this number sits three lines from the
# quota it has to agree with instead of in conduct's descriptor in the other
# repository, with nothing checking that the two match. Every member inherits
# it, which is right: the Windmill units are already inside this quota, so
# pinning changes WHERE they run rather than how much they get.
AllowedCPUs=0-3
IOWeight=20
# NO LONGER THE NUMBER WITH NOTHING BEHIND IT. It was, and the comment said so
# until a real gate run could be measured: on 2026-08-20 a full upskald gate in
# the runner, with all four Windmill units and three phase datastores in here,
# took the slice to a pids.peak of 325 - 21% of this. The runner's own scope
# peaked at 91 tasks against its 1,024.
#
# Left at 1,536 rather than tightened toward the measurement, because the
# symptom when it binds is `fork: Resource temporarily unavailable` raised by
# something unrelated, naming neither the slice nor the limit, and a second
# concurrent phase is a supported configuration that has not been measured yet.
TasksMax=1536
