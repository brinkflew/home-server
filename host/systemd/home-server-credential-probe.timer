# ==============================================================================
# Daily, and the number is an argument that was already had
# ------------------------------------------------------------------------------
# DAILY RATHER THAN HOURLY, AND THAT IS THE WHOLE REASON THIS EXISTS AS A TIMER.
# bin/verify-host.sh's agents.publish_configured rejected a live credential
# probe outright, on the explicit grounds of "~8,760 GitHub auths a year for a
# credential that almost never changes". That objection is to the CADENCE and it
# is correct. 365 is a different number, and it buys the one thing presence and
# freshness cannot: whether the credential is still accepted.
#
# 02:40 BECAUSE EVERY OTHER SLOT IS TAKEN. podman-auto-update is ~00:00, the
# backup is 03:00, the CI sweep 04:00, the search sweep 04:30, the mirror 04:42,
# the agents update 04:59, and the restore verifications 05:30. This is three
# HTTP requests and could run anywhere; putting it in the one gap means a person
# reading `systemctl --user list-timers` after an incident is not trying to work
# out which of two jobs at the same minute did something.
#
# NOT INSIDE THE SUNDAY REBOOT WINDOW either, which is 05:00 to 09:00. Nothing
# here would interfere with it - this makes no local change at all - but a
# network call landing in the window is one more thing to rule out when a window
# is refused, and it costs nothing to avoid.
#
# Persistent=true SO A HOST THAT WAS OFF DOES NOT SILENTLY SKIP A DAY. The
# credential could have been revoked while it was down, which is exactly when
# catching up matters.
#
# AND THEREFORE A ONE-TIME START IS REQUIRED, in host/systemd/README.md beside
# the enable line. `systemctl --user enable --now` writes the stamp file
# immediately, so there is no missed elapse and the unit does NOT fire: the
# first probe would wait until the next 02:40 and the three checks would report
# "has NEVER been probed" until then. This repository has been caught by that
# six times and the README says so.
#
# RandomizedDelaySec= because three of the four things this talks to are other
# people's APIs, and a request arriving at exactly the same second every day is
# the one shape a rate limiter is built to notice.
# ==============================================================================

[Unit]
Description=Probe the credentials whose failure is otherwise silent, daily

[Timer]
OnCalendar=*-*-* 02:40:00
Persistent=true
RandomizedDelaySec=10min
AccuracySec=5min

[Install]
WantedBy=timers.target
