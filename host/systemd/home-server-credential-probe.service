# ==============================================================================
# Ask the three credentials nothing else here asks
# ------------------------------------------------------------------------------
# THREE CHECKS SAY THIS IS UNMEASURED IN THEIR OWN PASS MESSAGES.
# agents.model_credential and agents.publish_configured both ended "neither of
# which proves the token still authenticates", deliberately: a read of the
# filesystem establishes presence and freshness and nothing else. And every
# certificate on this host is its FIRST issuance, so GANDI_BEARER_TOKEN has
# never been exercised by the DNS-01 write that will renew all fifteen of them.
#
# WHAT RUNS HERE IS A PROBE AND WHAT GRADES IT IS THE BATTERY, which is the
# split every other job on this host already uses. bin/probe-credentials.sh
# writes ~/.cache/home-server/credential-state; ingress.dns_credential,
# agents.model_credential_valid and agents.publish_credential_valid read it an
# hour later. The battery makes no external call of its own outside --routes,
# which is manual, and that is why this is a unit rather than three more lines
# in bin/verify-host.sh.
#
# EXIT 0 ON A REJECTED CREDENTIAL. The script says so at length: the finding is
# in the marker, and a red unit here would report "the probe failed" for a run
# where the probe worked perfectly and the news was bad. Same choice
# bin/reboot-when-staged.sh and bin/reclaim-boot-slot.sh make.
#
# NO Before= AND NO Wants= ON ANYTHING. The 2026-08-30 outage was an ordering
# cycle systemd broke by DELETING conduct's job, with every container healthy
# and no failed unit, and `systemd-analyze verify` is silent on cycles because
# they belong to the job transaction rather than to a unit file. This job
# depends on nothing and nothing depends on it.
#
# TimeoutStartSec= COVERS THE THREE LEGS' OWN CEILINGS AND NOT MUCH MORE. Each
# call is bounded in the script - 20s for Gandi, 30s for the model API, 45s for
# the ls-remote plus 20 for GitHub - so the worst honest run is about two
# minutes. Five is the backstop for a leg that hangs somewhere its own timeout
# does not reach, because a Type=oneshot stuck in `activating` is invisible to
# host.failed_units: it is neither failed nor a container.
#
# Symlinked into ~/.config/systemd/user/ - see host/systemd/README.md.
# ==============================================================================

[Unit]
Description=Probe the credentials whose failure is otherwise silent
Documentation=file:/var/home-server/bin/probe-credentials.sh

[Service]
Type=oneshot
ExecStart=/var/home-server/bin/probe-credentials.sh
TimeoutStartSec=5min

# THREE HTTP REQUESTS AND ONE ls-remote. The ceiling is here because every other
# periodic unit on this host carries one and capacity.var_commitment adds them
# up; leaving it unbounded would make this the one job that could not be
# accounted for.
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=128M
MemoryMax=192M
