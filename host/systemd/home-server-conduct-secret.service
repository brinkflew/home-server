# ==============================================================================
# Put the runner's model credential into podman's secret store
# ------------------------------------------------------------------------------
# THIS IS NOT WHAT MAKES THE SECRET PERSIST. Podman secrets live under
# ~/.local/share/containers/storage/secrets and survive a reboot on their own, so
# a reader looking for the reason this unit exists will not find it there. It
# exists for two states that are otherwise only fixable by remembering:
#
#   A FRESH HOST, where the secret has never been created and every model phase
#   would fail at `podman run` naming something that does not exist.
#   A ROTATED .env, where render-env.sh has written a new token and the secret
#   still holds the old one - which is the bad case, because the phases keep
#   working and authenticate as the wrong credential until somebody notices.
#
# Both are self-healing within one boot with this in place, and "the secret
# exists" stops being a fact recorded only in somebody's shell history.
#
# NOT RemainAfterExit=yes. gate.NEVER_WATCH records why a RemainAfterExit oneshot
# is a trap - it reads `active` for the whole boot, so anything asking "is this
# busy?" gets the wrong answer for ever. Nothing watches this unit today; the
# habit is worth keeping anyway, because the day something does is not the day to
# discover it.
#
# Before= rather than only Wants=, so conduct never starts into a host where the
# secret is stale. The Wants= on the conduct unit is safe here and does NOT
# repeat the trap that file's own comment names: that one is about pulling a
# whole service stack up behind something somebody deliberately stopped, and this
# is a oneshot that writes one secret and exits.
#
# Symlinked into ~/.config/systemd/user/ - see host/systemd/README.md.
# ==============================================================================

[Unit]
Description=Sync podman secrets from the rendered .env
Documentation=file:/var/home-server/docs/agents.md
After=default.target
Before=home-server-conduct.service

[Service]
Type=oneshot
ExecStart=/var/home-server/bin/sync-podman-secrets.sh
# The script refuses on an empty value rather than creating an empty secret - a
# container started with one authenticates as nobody, and that reads as a model
# outage twenty minutes later rather than as a configuration error now.
Nice=10

[Install]
WantedBy=default.target
